# Copy to .env and fill in. Never commit .env.

# From BotFather (https://t.me/BotFather) — create a bot, then add it to your team group.
TELEGRAM_BOT_TOKEN=

# From https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- optional ---
# JOHNNY_MODEL=claude-opus-5
# JOHNNY_MAX_TOKENS=1024
# Comma-separated Telegram user IDs. If set, Johnny answers only these people.
# JOHNNY_ALLOWED_USER_IDS=
